{
  "generator-jhipster": {
    "applicationType": "gateway",
    "authenticationType": "oauth2",
    "baseName": "Gateway",
    "buildTool": "gradle",
    "cacheProvider": "no",
    "clientFramework": "react",
    "databaseType": "no",
    "devDatabaseType": "no",
    "enableSwaggerCodegen": true,
    "enableTranslation": true,
    "entities": [],
    "jhipsterVersion": "8.8.0",
    "languages": ["ko", "en"],
    "messageBroker": "no",
    "monorepository": true,
    "nativeLanguage": "ko",
    "packageName": "backend.jshong.poc.jhipster.gateway",
    "prodDatabaseType": "no",
    "reactive": true,
    "serverPort": "8080",
    "serviceDiscoveryType": "consul",
    "skipCommitHook": true,
    "skipUserManagement": true,
    "testFrameworks": ["gatling"],
    "websocket": "no"
  }
}
